# Action Line-Up Environment Configuration

# --- Supabase Configuration ---
# Your Supabase Project URL (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Public Anonymous API Key (Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your Supabase Service Role Secret Key (Settings > API > service_role secret)
# Required for server-side administrative tasks and bootstrapping
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- League Owner Configuration ---
# The email address that automatically inherits the 'owner' role on signup/signin
OWNER_EMAIL=admin@actionlineup.com

# --- Site URL ---
# Base URL for redirects (Stripe return URLs, password reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe Billing Configuration (Optional for initial demo) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PREMIUM=price_...
